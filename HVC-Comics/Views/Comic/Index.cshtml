@using HVC_Comics.Views.Comic
@model HVC_Comics.Models.Comic?

@section Styles {
    <link rel="stylesheet" href="~/css/comic.css" />
}

@{
    ViewData["Title"] = "Comics Database";
    ComicView? comicView = Model is not null ? new ComicView(Model) : null;
    var editions = ViewData["Editions"] as List<HVC_Comics.Models.Comic>
        ?? [];
}

<div class="home-page @(comicView?.EditorClass)">

    @if (Model is null)
    {
        <section class="random-empty">
            <div class="random-icon">🎲</div>
            <h1>Comics Database</h1>
            <p>Não foi possível encontrar uma revista.</p>

            <a asp-controller="Home" asp-action="Index" class="comic-button">
                Tentar novamente
            </a>
        </section>
    }
    else
    {
        <article class="comic-card @comicView!.EditorClass">

            <div class="comic-cover-container">
                @if (!string.IsNullOrWhiteSpace(comicView.CoverUrl))
                {
                    <img src="@comicView.CoverUrl" alt="Capa de @Model.Name nº @Model.Number" class="comic-cover"
                         loading="eager" width="330" height="500" />
                }
                else
                {
                    <div class="comic-cover-placeholder">
                        <span>📚</span>
                        <small>Sem capa disponível</small>
                    </div>
                }

                @* <span class="comic-id-cover">@Model.Id</span> *@
            </div>

            <div class="comic-information">

                <div class="comic-heading">

                    <div class="comic-heading-title">
                        <h1>
                            @comicView.Name #@Model.Number.ToString("D2")
                        </h1>
                    </div>

                    <div class="comic-heading-logos">
                        @foreach (var logo in comicView.AllLogos)
                        {
                            var isSmall =
                                logo.Contains("marvel", StringComparison.OrdinalIgnoreCase) ||
                                logo.Contains("panini", StringComparison.OrdinalIgnoreCase) ||
                                logo.Contains("activision", StringComparison.OrdinalIgnoreCase) ||
                                logo.Contains("dynamite", StringComparison.OrdinalIgnoreCase);

                            <img src="@logo" asp-append-version="true" class="publisher-logo @(isSmall ? "logo-small" : null)"
                                 alt="Logotipo da editora ou licenciante" />
                        }

                        @if (comicView.PublisherLogos.Count == 0 &&
                             comicView.LicensorLogos.Count == 0)
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.Publisher))
                            {
                                <strong class="publisher-fallback">
                                    @Model.Publisher
                                </strong>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Licensor))
                            {
                                <strong class="publisher-fallback">
                                    @Model.Licensor
                                </strong>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ComicTitle) &&
                     !Model.ComicTitle.Equals(
                         "Nenhum",
                         StringComparison.OrdinalIgnoreCase))
                {
                    <h2 class="comic-title">@Model.ComicTitle</h2>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CoverChar))
                {
                    <p class="comic-cover-char">@Model.CoverChar</p>
                }

                <div class="comic-info-row">

                    <div class="comic-info-item info-published">
                        <span>Publicação</span>
                        <strong>@Model.ComicMonth/@Model.ComicYear</strong>
                    </div>

                    <div class="comic-info-item info-price">
                        <span>Preço</span>
                        <strong>@Model.Coin @Model.Price.ToString("N2")</strong>
                    </div>

                    <div class="comic-info-item info-frequency">
                        <span>Periodicidade</span>
                        <strong>@Model.Frequency</strong>
                    </div>

                    <div class="comic-info-item @comicView.StatusClass">
                        <span>Status</span>
                        <strong>@Model.ComicSituation</strong>
                    </div>

                </div>

                <div class="comic-info-row comic-info-row-green">

                    <div class="comic-info-item">
                        <span>Formato</span>
                        <strong>@Model.Format</strong>
                    </div>

                    <div class="comic-info-item">
                        <span>Páginas</span>
                        <strong>@Model.Pages</strong>
                    </div>

                    <div class="comic-info-item">
                        <span>Histórias</span>
                        <strong>@Model.Stories</strong>
                    </div>

                    <div class="comic-info-item">
                        <span>Matérias</span>
                        <strong>@Model.Articles</strong>
                    </div>

                </div>

                <div class="comic-info-row comic-info-row-three">

                    <div class="comic-info-item">
                        <span>Papel</span>
                        <strong>@Model.PaperType</strong>
                    </div>

                    <div class="comic-info-item">
                        <span>Lombada</span>
                        <strong>@Model.Binding</strong>
                    </div>

                    <div class="comic-info-item">
                        <span>Tipo de capa</span>
                        <strong>@Model.CoverType</strong>
                    </div>

                </div>

                <div class="comic-flags">

                    @if (editions.Count > 1)
                    {
                        <a class="edition-gallery-link" href="@ViewData["GalleryUrl"]">
                            Galeria
                        </a>
                    }

                    <div class="comic-flags-items">

                        @if (Model.HaveMail)
                        {
                            <span>✉️ Correio</span>
                        }

                        @if (Model.HaveChecklist)
                        {
                            <span>☑️ Checklist</span>
                        }

                        @if (Model.IsBook)
                        {
                            <span>📚 Encadernado</span>
                        }

                        @if (Model.IsReedition)
                        {
                            <span>🔄 Reedição</span>
                        }

                        @if (Model.IsCrossover)
                        {
                            <span>🔀 Crossover</span>
                        }

                        @if (Model.IsBlackWhite)
                        {
                            <span>⚫ Preto e branco</span>
                        }

                        @if (Model.IsLastEdition)
                        {
                            <span>⭐ Última edição</span>
                        }

                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ComicCall) &&
                     !Model.ComicCall.Equals(
                         "Nenhuma",
                         StringComparison.OrdinalIgnoreCase))
                {
                    <div class="comic-call">
                        <span>@Model.ComicCall</span>
                    </div>
                }

            </div>
        </article>

        /* Editions links */
        @if (editions.Count > 1)
        {
            <nav class="comic-edition-navigation" aria-label="Navegação entre edições">

                @foreach (var edition in editions)
                {
                    var slug = ComicSlug.Create(edition.Name, edition.Number);
                    var isCurrent = edition.Id == Model.Id;

                    <a class="edition-number-link @(isCurrent ? "is-current" : "")" asp-controller="Comic" asp-action="Edition"
                       asp-route-slug="@slug" aria-current="@(isCurrent ? "page" : null)" title="@edition.Name nº @edition.Number">
                        @edition.Number.ToString("D2")
                    </a>
                }

            </nav>
        }
    }
</div>

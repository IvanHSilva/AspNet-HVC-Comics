@model HVC_Comics.Models.PaginationResult<HVC_Comics.Models.Comic>

@section Styles {
    <link rel="stylesheet" href="~/css/comic.css" />
}

@{
    ViewData["Title"] = "Revistas";
}

<div class="comic-header">
    <h1>📚 Revistas</h1>
</div>

<div class="comic-info-bar">

    <div class="comic-info-left">
        <span>
            <strong>Página:</strong> @Model.CurrentPage de @Model.TotalPages
        </span>

        <span>
            <strong>Total:</strong> @Model.TotalRecords registros
        </span>
    </div>

    <div>
        <span class="badge bg-primary"> Exibindo @Model.Items.Count registros</span>
    </div>

</div>


<div class="comic-table-container">
    <table class="comic-table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Revista</th>
                <th>Edição</th>
                <th>Editora BR</th>
                <th>Editora EUA</th>
                <th>Mês</th>
                <th>Ano</th>
                <th>Preço</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var comic in Model.Items)
            {

                    <tr class="comic-row @(comic.Licensor.Contains("Marvel", StringComparison.OrdinalIgnoreCase)
                        ? "edit-marvel" : comic.Licensor.Contains("DC", StringComparison.OrdinalIgnoreCase)
                        ? "edit-dc" : comic.Name.Contains("Wiz", StringComparison.OrdinalIgnoreCase)
                        || comic.Name.Contains("Super-Heróis", StringComparison.OrdinalIgnoreCase)
                        ? "edit-info" : "edit-outra")">
                    <td data-label="Código">@comic.Id</td>
                    <td data-label="Revista">@comic.Name</td>
                    <td data-label="Edição">@comic.Number.ToString("D2")</td>
                    <td data-label="Editora BR">@comic.Publisher</td>
                    <td data-label="Editora EUA">@comic.Licensor</td>
                    <td data-label="Mês">@comic.ComicMonth</td>
                    <td data-label="Ano">@comic.ComicYear</td>
                    <td data-label="Preço">@comic.Price.ToString("C")</td>
                </tr>
            }
        </tbody>    
    </table>
</div>

<nav aria-label="Navegação de páginas">

    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="1"><<</a>
        </li>

        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"><</a>
        </li>

        @{
            int visiblePages = 20;

            if (Context.Request.Headers["User-Agent"]
                .ToString()
                .Contains("Mobile"))
            {
                visiblePages = 7;
            }

            int startPage = Math.Max(1, Model.CurrentPage - (visiblePages / 2));
            int endPage = Math.Min(Model.TotalPages, startPage + visiblePages - 1);

            if (endPage - startPage < visiblePages - 1)
            {
                startPage = Math.Max(1, endPage - visiblePages + 1);
            }
        }

        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="1">1</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }

        @if (endPage < Model.TotalPages)
        {
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>

            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages">
                    @Model.TotalPages
                </a>
            </li>
        }

        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">></a>
        </li>

        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages">>></a>
        </li>
    </ul>
</nav>
